# =============================================================================
# Cavalieri Align API — Environment Variables
# =============================================================================
#
# HOW TO USE THIS FILE:
#   1. Copy this file: cp .env.example .env
#   2. Fill in the real values in .env
#   3. Never commit .env — it is gitignored
#
# WHERE TO FIND THESE VALUES:
#   Supabase dashboard → Project Settings → API
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

# Your project URL — visible in Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — used for user-scoped queries (respects RLS)
# Supabase dashboard → Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used by stores for engine-side writes (bypasses RLS)
# Supabase dashboard → Settings → API → Project API keys → service_role
# KEEP THIS SECRET — never expose to the frontend or commit to git
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# -----------------------------------------------------------------------------
# Credential Encryption
# Used to encrypt broker credentials (MQTT passwords, etc.) before storing
# them in the database. Must be exactly 64 hex characters (= 32 bytes).
#
# Generate a new key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------

CREDENTIAL_ENCRYPTION_KEY=your-64-char-hex-key-here


# -----------------------------------------------------------------------------
# Auth
# Controls whether the API enforces JWT authentication on protected routes.
# Always true in production and staging.
# Can be set to false locally during development to skip auth checks.
# -----------------------------------------------------------------------------

REQUIRE_AUTH=true


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

NODE_ENV=development
# Options: development | production
# Set to production on staging and prod deployments.
