{
  "name": "align-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/align-api/src",
  "projectType": "application",
  "tags": ["type:backend"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/align-api",
        "main": "apps/align-api/src/main.ts",
        "tsConfig": "apps/align-api/tsconfig.app.json",
        "assets": ["apps/align-api/src/assets"],
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "platform": "node",
        "target": "node20",
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "minify": true
          }
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "align-api:build",
        "watch": true
      },
      "configurations": {
        "production": {
          "buildTarget": "align-api:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
